<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <!-- Manual re-launch of the duplicated task stages merge. -->
  <record id="action_merge_duplicate_stages" model="ir.actions.server">
    <field name="name">Merge Duplicate Task Stages</field>
    <field name="model_id" ref="project.model_project_task_type" />
    <field name="state">code</field>
    <field name="code">action = model.action_merge_duplicate_stages()</field>
  </record>

  <menuitem
    name="Merge Duplicate Task Stages"
    id="menu_merge_duplicate_stages"
    parent="project.menu_project_config"
    action="action_merge_duplicate_stages"
    groups="project.group_project_manager"
    sequence="11"
  />
</odoo>
