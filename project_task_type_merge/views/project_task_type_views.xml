<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <!-- Show the task stages list without the default grouping by project.
         Emptying the attribute through inheritance removes it entirely. -->
  <record id="task_type_tree_inherited" model="ir.ui.view">
    <field name="name">project.task.type.list.inherited.merge</field>
    <field name="model">project.task.type</field>
    <field name="inherit_id" ref="project.task_type_tree_inherited" />
    <field name="arch" type="xml">
      <xpath expr="//list" position="attributes">
        <attribute name="default_group_by" />
      </xpath>
    </field>
  </record>
  <!-- Show the task stages kanban without the default grouping by project. -->
  <record id="view_project_task_type_kanban" model="ir.ui.view">
    <field name="name">project.task.type.kanban.merge</field>
    <field name="model">project.task.type</field>
    <field name="inherit_id" ref="project.view_project_task_type_kanban" />
    <field name="arch" type="xml">
      <xpath expr="//kanban" position="attributes">
        <attribute name="default_group_by" />
      </xpath>
    </field>
  </record>
</odoo>
