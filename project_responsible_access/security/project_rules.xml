<?xml version="1.0"?>
<odoo>
  <data>
    <record id="project_project_responsible_rule" model="ir.rule">
      <field name="name">Proyectos del responsable</field>
      <field name="model_id" ref="project.model_project_project"/>
      <field name="groups" eval="[(4, ref('project_responsible_access.group_project_responsible'))]"/>
      <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
    </record>

    <record id="project_task_responsible_rule" model="ir.rule">
      <field name="name">Tareas de proyectos del responsable</field>
      <field name="model_id" ref="project.model_project_task"/>
      <field name="groups" eval="[(4, ref('project_responsible_access.group_project_responsible'))]"/>
      <field name="domain_force">[('project_id.user_id', '=', user.id)]</field>
    </record>

    <record id="hr_timesheet_responsible_rule" model="ir.rule">
      <field name="name">Tiempos de proyectos del responsable</field>
      <field name="model_id" ref="hr_timesheet.model_account_analytic_line"/>
      <field name="groups" eval="[(4, ref('project_responsible_access.group_project_responsible'))]"/>
      <field name="domain_force">['|', ('task_id.project_id.user_id', '=', user.id), ('project_id.user_id', '=', user.id)]</field>
    </record>
  </data>
</odoo>