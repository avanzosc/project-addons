<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="view_sale_project_inherit_form" model="ir.ui.view">
    <field name="model">project.task</field>
    <field
      name="inherit_id"
      ref="sale_project_usability.view_sale_project_inherit_form"
    />
    <field name="arch" type="xml">
      <field name="sale_line_product_id" position="attributes">
        <attribute name="invisible">1</attribute>
      </field>
      <field name="sale_line_product_uom_qty" position="attributes">
        <attribute name="invisible">1</attribute>
      </field>
    </field>
  </record>

  <record id="view_task_form2" model="ir.ui.view">
    <field name="model">project.task</field>
    <field name="inherit_id" ref="project.view_task_form2" />
    <field name="arch" type="xml">
      <notebook position="before">
        <separator string="Costs" />
        <group col="3">
          <group>
            <field
              name="sale_line_product_id"
              invisible="not partner_id"
              readonly="sale_line_id != False"
            />
          </group>
          <group>
            <field
              name="sale_line_product_category_id"
              invisible="not partner_id"
              readonly="1"
            />
          </group>
          <group>
            <field
              name="product_uom_id"
              invisible="not partner_id"
              readonly="sale_line_id != False"
            />
          </group>
        </group>
        <group col="3">
          <group>
            <field
              name="sale_line_product_uom_qty"
              invisible="not partner_id"
              readonly="sale_line_id != False"
            />
          </group>
          <group>
            <field
              name="sale_line_sale_price"
              invisible="not partner_id"
              readonly="sale_line_id != False"
            />
          </group>
          <group>
            <field
              name="product_standard_price"
              invisible="not partner_id"
              readonly="sale_line_id != False"
            />
          </group>
        </group>
        <group col="3">
          <group>
            <field name="sale_subtotal" invisible="not partner_id" />
          </group>
          <group>
            <field name="total_cost" invisible="not partner_id" />
          </group>
          <group>
            <field name="profit" invisible="not partner_id" />
          </group>
        </group>
      </notebook>
    </field>
  </record>

  <record id="project_task_view_tree_main_base" model="ir.ui.view">
    <field name="model">project.task</field>
    <field name="inherit_id" ref="project.project_task_view_tree_main_base" />
    <field name="arch" type="xml">
      <field name="date_deadline" position="after">
        <field name="sale_line_product_id" optional="hide" />
        <field name="sale_line_product_category_id" optional="hide" />
        <field name="sale_line_product_uom_qty" optional="hide" />
        <field name="sale_line_sale_price" optional="hide" />
        <field name="sale_subtotal" optional="show" sum="Total Subtotal" />
        <field name="product_standard_price" optional="hide" />
        <field name="total_cost" optional="show" sum="Total Cost" />
        <field name="profit" optional="show" sum="Total Profit" />
      </field>
    </field>
  </record>

  <record id="view_task_search_form_base" model="ir.ui.view">
    <field name="model">project.task</field>
    <field name="inherit_id" ref="project.view_task_search_form_base" />
    <field name="arch" type="xml">
      <field name="partner_id" position="after">
        <field name="sale_line_product_id" />
        <field name="sale_line_product_category_id" />
      </field>
      <filter name="company_id" position="before">
        <filter
          string="Sale Product"
          name="sale-product"
          context="{'group_by': 'sale_line_product_id'}"
        />
        <filter
          string="Sale Product Category"
          name="sale-product-categ"
          context="{'group_by': 'sale_line_product_category_id'}"
        />
      </filter>
    </field>
  </record>
</odoo>
